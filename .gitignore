# CMake and Ninja output
/build/
/build-*/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
build.ninja
.ninja_deps
.ninja_log

# Apple build output and local IDE state
DerivedData/
*.xcuserstate
*.xcuserdata/
.DS_Store
__pycache__/
*.py[cod]

# Model assets are fetched and converted locally; keep copyrighted checkpoints
# and generated runtime weights out of Git history.
/models/local/
/models/cache/
# Step 11D.2 native DXVK outputs are retained in the local content-addressed
# store. Evidence manifests pin their hashes; do not stage absolute CAS symlinks
# or multi-gigabyte build products in the source repository.
/experiments/dxvk_macos_step11dR/evidence/**/d3d11.dll
/experiments/dxvk_macos_step11dR/evidence/**/dxgi.dll
# GitHub rejects individual files above 100 MiB. Keep the original captures
# locally and track their byte-exact gzip archives beside them.
/experiments/dxvk_macos_step11dR/evidence/step11d2-diagnostic/diag-300s-10-low-candidate/runtime.log
/experiments/dxvk_macos_step11dR/evidence/step11d2-diagnostic/diag-300s-10-low-candidate/slow-visual_d3d11.log

# Large raw captures and rebuildable control binaries stay local; reports,
# compact run results, manifests, analyses, and cleanup receipts remain reviewable.
/experiments/dxvk_macos_step11d3a/evidence/native-runs/**/trace.jsonl
/experiments/dxvk_macos_step11d3b/runs/
/experiments/dxvk_macos_step11d3b/control/*.exe
/experiments/dxvk_macos_step11d3b/control/*.dylib
/experiments/dxvk_macos_step11d3b/control/test_proxy_device_dispatch
/experiments/dxvk_macos_step11d3b/test_proxy_device_dispatch
/experiments/dxvk_macos_step11d3b/evidence/**/*.exe
/experiments/dxvk_macos_step11d3b/evidence/**/*.dylib
/experiments/dxvk_macos_step11d3b/evidence/**/public-window-observer
/experiments/dxvk_macos_step11d3b/evidence/br4/collision-proof/collision_harness
/experiments/dxvk_macos_step11d3b/evidence/br7/ownership-test
/experiments/dxvk_macos_step11d3b/evidence/br7/ownership-test-final
# Retain verified archives and receipts locally; this 335 MB archive exceeds
# GitHub's per-file size limit.
/experiments/dxvk_macos_step11d3b/evidence/br7/superseded-pre-br7.tar.gz

# Local scratch and agent workspace state. These are shell-accident paths and
# tool caches, not project material.
/--help/
/--verbose=4
/.workbuddy-ai/

# R6 local provenance archive store. Holds git bundles, source tarballs, and
# workspace snapshots used for host-local recovery; the reviews and reports that
# cite them are tracked.
/r6/

# MetalFX title-integration evidence (R92-R121). Raw GPU frame dumps, captured
# frames, per-process observer logs, and built observers run to tens of
# gigabytes per round. Reports, analysers, run summaries, and the observer
# sources stay tracked so every published claim remains reviewable.
/experiments/metalfx_frame_interpolator_R93/evidence/**/*.raw
/experiments/metalfx_frame_interpolator_R93/evidence/**/*.rg16f
/experiments/metalfx_frame_interpolator_R93/evidence/**/*.rgba16f
/experiments/metalfx_frame_interpolator_R93/evidence/**/*.rgba32f
/experiments/metalfx_frame_interpolator_R93/evidence/**/*.rg32f
/experiments/metalfx_frame_interpolator_R93/evidence/**/*.jsonl
/experiments/metalfx_frame_interpolator_R93/evidence/**/*.png
/experiments/metalfx_frame_interpolator_R93/evidence/**/*.dylib
/experiments/metalfx_frame_interpolator_R93/evidence/**/*.exe
/experiments/metalfx_frame_interpolator_R93/evidence/**/observer*.log
/experiments/metalfx_frame_interpolator_R93/*.dylib
/experiments/metalfx_frame_interpolator_R93/provider_smoke
/experiments/metalfx_frame_interpolator_R93/frame_interpolator_smoke

# Storage-gate generated dumps. Single attestations and structured-output files
