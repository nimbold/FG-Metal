+  void Presenter::cancelSourceImageLease() {
+    std::lock_guard lock(m_surfaceMutex);
+
+    if (!m_activeImageLease || m_activeOrigin != DxvkPresentOrigin::ApplicationSource)
+      return;
+
+    try {
+      Logger::warn(str::format(
