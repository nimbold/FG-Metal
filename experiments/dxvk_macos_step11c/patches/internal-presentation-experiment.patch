+  void Presenter::releaseInternalImageLeaseBeforeSubmit() {
+    std::lock_guard lock(m_surfaceMutex);
+
+    if (!m_activeImageLease || m_activeOrigin != DxvkPresentOrigin::InternalOutput)
+      return;
+
+    const bool canReturnCachedImage = m_swapchain != VK_NULL_HANDLE
+      && m_activeImageGeneration == m_swapchainGeneration.load()
+      && m_acquireStatus == VK_SUCCESS
+      && !m_dirtySurface
+      && !m_dirtySwapchain;
+
+    if (canReturnCachedImage) {
+      try {
+        Logger::info(str::format(
+          "InternalWSI: released pre-submit image lease acquire=",
+          m_activeAcquireSerial, " image=", m_activeImageIndex,
+          " generation=", m_activeImageGeneration,
+          " cached-acquire=preserved"));
+      } catch (...) {
+      }
+    } else {
+      try {
+        Logger::warn(str::format(
+          "InternalWSI: retiring unusable pre-submit image lease acquire=",
+          m_activeAcquireSerial, " image=", m_activeImageIndex,
+          " generation=", m_activeImageGeneration,
+          " current-generation=", m_swapchainGeneration.load(),
+          " dirty-surface=", m_dirtySurface,
+          " dirty-swapchain=", m_dirtySwapchain,
+          " acquire-status=", m_acquireStatus));
+      } catch (...) {
+      }
+      m_dirtySwapchain = true;
+      m_acquireStatus = VK_NOT_READY;
+    }
+
+    // No queue submission consumed the acquire semaphore or touched the
+    // WSI image. Keep a still-valid cached acquisition available to the next
+    // application source present; retire only an invalidated swapchain epoch.
+    m_activeImageLease = false;
+    m_activeImageIndex = UINT32_MAX;
+    m_activeImageGeneration = 0u;
+    m_presentPending = false;
+    m_surfaceCond.notify_all();
+  }
