+
+  void Presenter::cancelInternalImageLease() {
+    std::lock_guard lock(m_surfaceMutex);
+
+    if (!m_activeImageLease || m_activeOrigin != DxvkPresentOrigin::InternalOutput)
+      return;
+
+    try {
+      Logger::warn(str::format(
+        "InternalWSI: dropping acquired image ", m_activeImageIndex,
+        " after internal submission failure; recreating swapchain"));
