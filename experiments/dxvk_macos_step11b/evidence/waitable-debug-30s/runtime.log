#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float2 o_coord [[user(locn0)]];
    float4 gl_Position [[position]];
};

vertex main0_out main0(uint gl_VertexIndex [[vertex_id]])
{
    main0_out out = {};
    float2 coord = float2(float(int(gl_VertexIndex) & 2), float(int(gl_VertexIndex) & 1) * 2.0);
    out.o_coord = coord;
    out.gl_Position = float4(float2(-1.0) + (coord * 2.0), 0.0, 1.0);
    out.gl_Position.y = -(out.gl_Position.y);    // Invert Y-axis for Metal
    return out;
}


