+// Local-only, downstream DXMT display-tick experiment. Handles remain opaque
+// to the Windows side; native ownership and Objective-C object access stay in
+// WineMetal's Unix implementation.
+enum WMTDXMTFramegenOutputKind : uint32_t {
+  WMTDXMTFramegenOutputNone = 0,
+  WMTDXMTFramegenOutputSource = 1,
+  WMTDXMTFramegenOutputGenerated = 2,
+};
