+@interface DXMTFramegenNativeSession : NSObject <CAMetalDisplayLinkDelegate> {
+@public
+  void *_native_state;
+@private
+  __strong CAMetalDisplayLink *_display_link;
+  std::atomic<bool> _accepting_callbacks;
+  std::atomic<uint32_t> _callbacks_in_flight;
+  std::mutex _callback_mutex;
+  std::condition_variable _callback_cv;
+}
+- (instancetype)initWithLayer:(CAMetalLayer *)layer device:(id<MTLDevice>)device;
+- (void)start;
+- (void)pauseDelivery;
+- (BOOL)resumeDelivery;
+- (void)stop;
+@end
+
+@interface DXMTFramegenReservationToken : NSObject {
+@public
+  std::shared_ptr<ReservationState> _reservation;
+}
+- (instancetype)initWithReservation:
+    (std::shared_ptr<ReservationState>)reservation;
+@end
+
+@implementation DXMTFramegenNativeSession
+- (instancetype)initWithLayer:(CAMetalLayer *)layer device:(id<MTLDevice>)device {
+  self = [super init];
+  if (self == nil || layer == nil || device == nil)
+    return nil;
+  _accepting_callbacks.store(false, std::memory_order_relaxed);
+  _callbacks_in_flight.store(0, std::memory_order_relaxed);
+  static std::atomic<uint64_t> next_presenter_id{1};
+  const uint64_t presenter_id =
+      next_presenter_id.fetch_add(1, std::memory_order_relaxed);
+  auto state = std::make_unique<NativeState>(device, layer, presenter_id);
+  auto backend = framegen::dxmt_synthetic::SyntheticMetalBackend::create(device);
+  if (!backend)
+    return nil;
+  auto generator = framegen::FrameGenerator::create(*backend);
+  if (!generator)
+    return nil;
+  state->backend = std::move(*backend);
+  state->generator.emplace(std::move(*generator));
+  _native_state = state.release();
+  if (@available(macOS 14.0, *)) {
+    _display_link = [[CAMetalDisplayLink alloc] initWithMetalLayer:layer];
+    if (_display_link == nil) {
+      delete static_cast<NativeState *>(_native_state);
+      _native_state = nullptr;
+      return nil;
+    }
+    _display_link.delegate = self;
+    _display_link.paused = YES;
+    _display_link.preferredFrameLatency = 1.0F;
+    _display_link.preferredFrameRateRange =
+        CAFrameRateRangeMake(60.0F, 60.0F, 60.0F);
+  } else {
+    delete static_cast<NativeState *>(_native_state);
+    _native_state = nullptr;
+    return nil;
+  }
+  return self;
+}
+
+- (void)start {
+  if (_display_link != nil)
+    [_display_link addToRunLoop:[NSRunLoop mainRunLoop]
+                       forMode:NSRunLoopCommonModes];
+}
+
+- (void)pauseDelivery {
+  std::unique_lock lock(_callback_mutex);
+  _accepting_callbacks.store(false, std::memory_order_release);
+  _display_link.paused = YES;
+  _callback_cv.wait(lock, [self] {
+    return self->_callbacks_in_flight.load(std::memory_order_acquire) == 0;
+  });
+  // A paused CAMetalDisplayLink still owns CAMetalLayer's drawable path, so
+  // -nextDrawable remains illegal for the ordinary DXMT Presenter. Detach the
+  // link completely during bypass, then build a fresh link on this same layer
+  // when the renderer resumes.
+  if (_display_link != nil) {
+    _display_link.delegate = nil;
+    [_display_link invalidate];
+    _display_link = nil;
+  }
+}
+
+- (BOOL)resumeDelivery {
+  std::unique_lock lock(_callback_mutex);
+  if (_display_link == nil) {
+    auto *state = static_cast<NativeState *>(_native_state);
+    if (state == nullptr || state->layer == nil)
+      return NO;
+    if (@available(macOS 14.0, *)) {
+      _display_link = [[CAMetalDisplayLink alloc]
+          initWithMetalLayer:state->layer];
+      if (_display_link == nil)
+        return NO;
+      _display_link.delegate = self;
+      _display_link.paused = YES;
+      _display_link.preferredFrameLatency = 1.0F;
+      _display_link.preferredFrameRateRange =
+          CAFrameRateRangeMake(60.0F, 60.0F, 60.0F);
+      [_display_link addToRunLoop:[NSRunLoop mainRunLoop]
+                         forMode:NSRunLoopCommonModes];
+    } else {
+      return NO;
+    }
+  }
+  _accepting_callbacks.store(true, std::memory_order_release);
+  _display_link.paused = NO;
+  return YES;
+}
+
+- (void)metalDisplayLink:(CAMetalDisplayLink *)link
+              needsUpdate:(CAMetalDisplayLinkUpdate *)update {
+  (void)link;
+  {
+    // Admission and pause share the mutex so pause cannot observe zero in
+    // flight after a callback's first enabled check but before its increment.
+    std::scoped_lock lock(_callback_mutex);
+    if (!_accepting_callbacks.load(std::memory_order_acquire))
+      return;
+    _callbacks_in_flight.fetch_add(1, std::memory_order_acq_rel);
+  }
+  auto finish_callback = [self] {
+    if (self->_callbacks_in_flight.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+      std::scoped_lock lock(self->_callback_mutex);
+      self->_callback_cv.notify_all();
+    }
+  };
+  if (!_accepting_callbacks.load(std::memory_order_acquire)) {
+    finish_callback();
+    return;
+  }
+  auto *state = static_cast<NativeState *>(_native_state);
+  try {
+    if (state != nullptr)
+      state->on_display_update(update);
+  } catch (...) {
+    // Exceptions must not cross the Objective-C delegate boundary.
+  }
+  finish_callback();
+}
+
+- (void)stop {
+  [self pauseDelivery];
+  auto *state = static_cast<NativeState *>(_native_state);
+  if (state != nullptr)
+    state->request_stop();
+}
+
+- (void)dealloc {
+  [self stop];
+  auto *state = static_cast<NativeState *>(_native_state);
+  if (state != nullptr) {
+    state->join_generation_thread();
+    delete state;
+  }
+  _native_state = nullptr;
+}
+@end
+
+@implementation DXMTFramegenReservationToken
+- (instancetype)initWithReservation:
+    (std::shared_ptr<ReservationState>)reservation {
+  self = [super init];
+  if (self != nil)
+    _reservation = std::move(reservation);
+  return self;
+}
+@end
