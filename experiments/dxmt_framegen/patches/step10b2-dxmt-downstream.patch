+  uint64_t epoch;
+  int64_t callback_ns;
+  int64_t render_deadline_ns;
+  int64_t target_presentation_ns;
+  uint64_t raw_callback_time_bits;
+  uint64_t raw_render_deadline_bits;
+  uint64_t raw_target_presentation_bits;
+  uint64_t callback_duration_ns;
+  // Filled by the DXMT presentation worker and consumed by the Unix bridge
+  // for stage-level pacing diagnostics. Times share the Mach nanosecond epoch.
+  uint64_t worker_wake_ns;
+  uint64_t mutex_wait_start_ns;
+  uint64_t mutex_acquired_ns;
+  uint64_t presenter_encode_start_ns;
+  uint64_t presenter_encode_end_ns;
+  uint64_t gpu_submit_ns;
+  uint64_t present_call_ns;
+  uint64_t lifecycle_state;
+  uint64_t circuit_state;
+};
