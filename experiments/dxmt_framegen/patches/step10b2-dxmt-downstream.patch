+
+int64_t mach_now_ns() {
+  static mach_timebase_info_data_t timebase = [] {
+    mach_timebase_info_data_t value{};
+    mach_timebase_info(&value);
+    return value;
+  }();
+  return static_cast<int64_t>(
+      (static_cast<__uint128_t>(mach_absolute_time()) * timebase.numer) /
+      timebase.denom);
+}
+
+double ca_now() { return CACurrentMediaTime(); }
+
+uint64_t double_bits(double value) {
+  return std::bit_cast<uint64_t>(value);
+}
+
+bool fail_at(const char *stage) {
+  const char *requested = std::getenv("DXMT_FRAMEGEN_FAIL");
+  return requested != nullptr && std::strcmp(requested, stage) == 0;
+}
+
+std::string log_path() {
+  if (const char *path = std::getenv("DXMT_FRAMEGEN_LOG")) {
+    if (*path != '\0')
+      return path;
+  }
+  return "/tmp/dxmt-framegen-" + std::to_string(getpid()) + ".csv";
+}
+
+struct ClockBridge {
+  double ca_origin{ca_now()};
+  int64_t mach_origin{mach_now_ns()};
+
+  int64_t to_mach(double ca_time) const {
+    const long double delta =
+        (static_cast<long double>(ca_time) - ca_origin) * 1'000'000'000.0L;
+    return mach_origin + static_cast<int64_t>(delta);
+  }
+};
