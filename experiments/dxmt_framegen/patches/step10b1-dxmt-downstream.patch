+  _display_link.paused = YES;
+  _display_link.delegate = nil;
+  [_display_link invalidate];
+  _display_link = nil;
+  {
+    std::unique_lock lock(_callback_mutex);
+    _callback_cv.wait(lock, [self] {
+      return self->_callbacks_in_flight.load(std::memory_order_acquire) == 0;
+    });
+  }
+  auto *state = static_cast<NativeState *>(_native_state);
+  if (state != nullptr)
+    state->request_stop();
+}
