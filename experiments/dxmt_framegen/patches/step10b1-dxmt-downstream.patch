+void NativeState::on_display_update(CAMetalDisplayLinkUpdate *update) {
+  const int64_t callback_start_ns = mach_now_ns();
+  if (stopping.load(std::memory_order_acquire) || update == nil)
+    return;
+  const double raw_callback = ca_now();
+  const double raw_deadline = update.targetTimestamp;
+  const double raw_target = update.targetPresentationTimestamp;
+  const int64_t callback_ns = callback_start_ns;
+  const int64_t deadline_ns = clock.to_mach(raw_deadline);
+  const int64_t target_ns = clock.to_mach(raw_target);
+  const int64_t phase_ns = target_ns - callback_ns;
+  if (phase_ns > 0 && phase_ns < 100'000'000) {
+    const int64_t previous = display_phase_ns.load(std::memory_order_relaxed);
+    display_phase_ns.store((previous * 7 + phase_ns) / 8,
+                           std::memory_order_relaxed);
+  }
+  const uint64_t tick_id = next_tick_id.fetch_add(1, std::memory_order_relaxed);
+  WMTDXMTFramegenTick tick{};
+  tick.tick_id = tick_id;
+  tick.epoch = epoch.load(std::memory_order_acquire);
+  tick.callback_ns = callback_ns;
+  tick.render_deadline_ns = deadline_ns;
+  tick.target_presentation_ns = target_ns;
+  tick.raw_callback_time_bits = double_bits(raw_callback);
+  tick.raw_render_deadline_bits = double_bits(raw_deadline);
+  tick.raw_target_presentation_bits = double_bits(raw_target);
+
+  // The callback only timestamps, retains its drawable, and enqueues a bounded
+  // record. It does not call Framegen, touch the state/log locks, or wait for
+  // the worker.
+  TickRecord item;
+  item.drawable = fail_at("drawable") ? nil : update.drawable;
+  {
+    std::scoped_lock lock(tick_mutex);
+    if (ticks.size() >= kTickQueueLimit) {
+      ticks.pop_front();
+      dropped_tick_count.fetch_add(1, std::memory_order_relaxed);
+    }
+    display_callback_count.fetch_add(1, std::memory_order_relaxed);
+    item.data = tick;
+    item.data.callback_duration_ns = static_cast<uint64_t>(
+        std::max<int64_t>(0, mach_now_ns() - callback_start_ns));
+    ticks.push_back(std::move(item));
+  }
+  tick_cv.notify_one();
+}
