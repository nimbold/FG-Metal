+WINEMETAL_API obj_handle_t
+DXMTFramegenSession_create(obj_handle_t layer, obj_handle_t device, uint32_t *out_available) {
+  struct unixcall_dxmtfg_session_create params = {0};
+  params.layer = layer;
+  params.device = device;
+  UNIX_CALL(146, &params);
+  if (out_available)
+    *out_available = params.ret_available;
+  return params.ret_session;
+}
+
+WINEMETAL_API int64_t
+DXMTFramegenMachNow(void) {
+  struct unixcall_dxmtfg_now params = {0};
+  UNIX_CALL(147, &params);
+  return params.ret_ns;
+}
+
+WINEMETAL_API uint64_t
+DXMTFramegenSession_epoch(obj_handle_t session) {
+  struct unixcall_dxmtfg_session_epoch params = {0};
+  params.session = session;
+  UNIX_CALL(148, &params);
+  return params.ret_epoch;
+}
+
+WINEMETAL_API bool
+DXMTFramegenSession_setEnabled(obj_handle_t session, bool enabled) {
+  struct unixcall_dxmtfg_session_set_enabled params = {0};
+  params.session = session;
+  params.enabled = enabled;
+  UNIX_CALL(149, &params);
+  return params.ret_enabled != 0;
+}
+
+WINEMETAL_API bool
+DXMTFramegenSession_canCapture(obj_handle_t session) {
+  struct unixcall_dxmtfg_session_can_capture params = {0};
+  params.session = session;
+  UNIX_CALL(150, &params);
+  return params.ret_can_capture != 0;
+}
+
+WINEMETAL_API obj_handle_t
+DXMTFramegenReserveSource(
+    obj_handle_t session, obj_handle_t command_queue, obj_handle_t source_texture,
+    uint64_t epoch, uint64_t source_id, int64_t source_timestamp_ns) {
+  struct unixcall_dxmtfg_reserve_source params = {0};
+  params.session = session;
+  params.command_queue = command_queue;
+  params.source_texture = source_texture;
+  params.epoch = epoch;
+  params.source_id = source_id;
+  params.source_timestamp_ns = source_timestamp_ns;
+  UNIX_CALL(151, &params);
+  return params.ret_reservation;
+}
+
+WINEMETAL_API void
+DXMTFramegenCommitSource(obj_handle_t session, obj_handle_t reservation) {
+  struct unixcall_dxmtfg_commit_source params = {session, reservation};
+  UNIX_CALL(152, &params);
+}
+
+WINEMETAL_API void
+DXMTFramegenCancelSource(obj_handle_t session, obj_handle_t reservation) {
+  struct unixcall_dxmtfg_cancel_source params = {session, reservation};
+  UNIX_CALL(158, &params);
+}
+
+WINEMETAL_API bool
+DXMTFramegenWaitTick(obj_handle_t session, uint64_t timeout_ms,
+                     struct WMTDXMTFramegenTick *out_tick) {
+  struct unixcall_dxmtfg_wait_tick params = {0};
+  params.session = session;
+  params.timeout_ms = timeout_ms;
+  WMT_MEMPTR_SET(params.out_tick, out_tick);
+  UNIX_CALL(153, &params);
+  return params.ret_has_tick != 0;
+}
+
+WINEMETAL_API void
+DXMTFramegenSelectOutput(obj_handle_t session,
+                         const struct WMTDXMTFramegenTick *tick,
+                         struct WMTDXMTFramegenSelection *out_selection) {
+  struct unixcall_dxmtfg_select_output params = {0};
+  params.session = session;
+  WMT_MEMPTR_SET(params.tick, (void *)tick);
+  WMT_MEMPTR_SET(params.out_selection, out_selection);
+  UNIX_CALL(154, &params);
+}
+
+WINEMETAL_API void
+DXMTFramegenReportPresentation(
+    obj_handle_t session, obj_handle_t command_buffer,
+    const struct WMTDXMTFramegenTick *tick,
+    const struct WMTDXMTFramegenSelection *selection) {
+  struct unixcall_dxmtfg_report_presentation params = {0};
+  params.session = session;
+  params.command_buffer = command_buffer;
+  WMT_MEMPTR_SET(params.tick, (void *)tick);
+  WMT_MEMPTR_SET(params.selection, (void *)selection);
+  UNIX_CALL(155, &params);
+}
+
+WINEMETAL_API void
+DXMTFramegenSession_reset(obj_handle_t session) {
+  UNIX_CALL(156, &session);
+}
+
+WINEMETAL_API void
+DXMTFramegenSession_stop(obj_handle_t session) {
+  UNIX_CALL(157, &session);
+}
