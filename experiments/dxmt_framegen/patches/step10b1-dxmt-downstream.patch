+    return;
+  _callbacks_in_flight.fetch_add(1, std::memory_order_acq_rel);
+  auto finish_callback = [self] {
+    if (self->_callbacks_in_flight.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+      std::scoped_lock lock(self->_callback_mutex);
+      self->_callback_cv.notify_all();
+    }
+  };
+  if (!_accepting_callbacks.load(std::memory_order_acquire)) {
+    finish_callback();
+    return;
+  }
+  auto *state = static_cast<NativeState *>(_native_state);
+  try {
+    if (state != nullptr)
+      state->on_display_update(update);
+  } catch (...) {
+    // Exceptions must not cross the Objective-C delegate boundary.
+  }
+  finish_callback();
+}
