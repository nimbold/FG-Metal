+    if (requested != framegen_requested_) {
+      framegen_requested_ = requested;
+      device_context_->WaitUntilGPUIdle();
+      framegen_session_.reset();
+      framegen_session_.setEnabled(requested && !occluded);
+      framegen_suspended_ = !requested || occluded;
+      return;
+    }
+    if (requested && occluded && !framegen_suspended_) {
+      device_context_->WaitUntilGPUIdle();
+      framegen_session_.setEnabled(false);
+      framegen_session_.reset();
+      framegen_suspended_ = true;
+    } else if (requested && !occluded && framegen_suspended_) {
+      framegen_session_.setEnabled(true);
