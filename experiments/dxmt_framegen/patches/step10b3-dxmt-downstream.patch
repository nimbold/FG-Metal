+@implementation DXMTFramegenNativeSession
+- (instancetype)initWithLayer:(CAMetalLayer *)layer device:(id<MTLDevice>)device {
+  self = [super init];
+  if (self == nil || layer == nil || device == nil)
+    return nil;
+  _accepting_callbacks.store(false, std::memory_order_relaxed);
+  _callbacks_in_flight.store(0, std::memory_order_relaxed);
+  static std::atomic<uint64_t> next_presenter_id{1};
+  const uint64_t presenter_id =
+      next_presenter_id.fetch_add(1, std::memory_order_relaxed);
+  auto state = std::make_unique<NativeState>(device, layer, presenter_id);
+  auto backend = framegen::dxmt_synthetic::SyntheticMetalBackend::create(device);
+  if (!backend)
+    return nil;
+  auto generator = framegen::FrameGenerator::create(*backend);
+  if (!generator)
+    return nil;
+  state->backend = std::move(*backend);
+  state->generator.emplace(std::move(*generator));
+  _native_state = state.release();
+  if (@available(macOS 14.0, *)) {
+    // NORMAL owns this layer through DXMT's Presenter. Do not even construct
+    // CAMetalDisplayLink until a primed escrow source reaches the activation
+    // boundary.
+  } else {
+    delete static_cast<NativeState *>(_native_state);
+    _native_state = nullptr;
+    return nil;
+  }
+  return self;
+}
