+bool claim_layer_owner(void *layer, void *session) {
+  std::scoped_lock lock(g_active_layer_owner_mutex);
+      auto [iter, inserted] = g_active_layer_owners.emplace(layer, session);
+  return inserted || iter->second == session;
+}
+
+void release_layer_owner(void *layer, void *session) {
+  std::scoped_lock lock(g_active_layer_owner_mutex);
+  auto iter = g_active_layer_owners.find(layer);
+  if (iter != g_active_layer_owners.end() && iter->second == session)
+    g_active_layer_owners.erase(iter);
