 private:
+  enum class FramegenLifecycle : uint64_t {
+    Stopped = 0,
+    Starting = 1,
+    Normal = 2,
+    Active = 3,
+    Draining = 4,
+    Stopping = 5,
+    Failed = 6,
+  };
+
+  void startFramegenExperiment() {
+    framegen_requested_ = env::getEnvVar("DXMT_FRAMEGEN_ENABLE") == "1";
+    if (!framegen_requested_)
+      return;
+    framegen_lifecycle_.store(FramegenLifecycle::Normal,
+                              std::memory_order_release);
+  }
+
+  bool ensureFramegenWorker() {
+    if (framegen_worker_.joinable()) {
+      if (!framegen_worker_exited_.load(std::memory_order_acquire))
+        return true;
+      // A failed worker can be restarted on a later supported Present. Join
+      // its completed thread exactly once before replacing the thread object.
+      framegen_worker_.join();
+    }
+
+    framegen_worker_stop_requested_.store(false, std::memory_order_release);
+    framegen_worker_exited_.store(false, std::memory_order_release);
+    try {
+      framegen_worker_ = std::thread([this] { framegenPresentationLoop(); });
+      return true;
+    } catch (...) {
+      framegen_worker_exited_.store(true, std::memory_order_release);
+      WARN("DXMT framegen display worker could not be started");
+      return false;
+    }
+  }
+
+  bool createFramegenSession() {
+    if (framegen_session_)
+      return true;
+
+    framegen_lifecycle_.store(FramegenLifecycle::Starting,
+                              std::memory_order_release);
+    uint32_t available = 0;
+    auto session = WMT::DXMTFramegenSession::create(
+        layer_weak_, device_->GetMTLDevice(), available);
+    if (!session || !available) {
+      WARN("DXMT framegen experiment requested, but the native display-tick session is unavailable");
+      framegen_lifecycle_.store(FramegenLifecycle::Failed,
+                                std::memory_order_release);
+      return false;
+    }
+    framegen_session_ = std::move(session);
+    framegen_command_queue_ =
+        device_->GetDXMTDevice().queue().metalCommandQueue();
+    if (!framegen_command_queue_) {
+      WARN("DXMT framegen experiment has no Metal command queue");
+      framegen_lifecycle_.store(FramegenLifecycle::Failed,
+                                std::memory_order_release);
+      return false;
+    }
+
+    // The native session remains detached from CAMetalLayer in NORMAL. A
+    // display link is constructed only after a primed escrow source exists
+    // and the ordinary presenter has drained.
+    framegen_lifecycle_.store(FramegenLifecycle::Normal,
+                              std::memory_order_release);
+    if (!ensureFramegenWorker()) {
+      framegen_lifecycle_.store(FramegenLifecycle::Failed,
+                                std::memory_order_release);
+      return false;
+    }
+    return true;
+  }
+
+  void stopFramegenExperiment() {
+    if (framegen_stop_started_.exchange(true, std::memory_order_acq_rel))
+      return;
+    framegen_lifecycle_.store(FramegenLifecycle::Draining,
+                              std::memory_order_release);
+    if (framegen_session_)
+      framegen_session_.quiesceToNormal();
+    framegen_lifecycle_.store(FramegenLifecycle::Stopping,
+                              std::memory_order_release);
+    framegen_stopping_.store(true, std::memory_order_release);
+    // The native session drains callback-owned drawables and both GPU paths
+    // before its layer ownership is released.
+    if (framegen_session_)
+      framegen_session_.stop();
+    if (framegen_worker_.joinable())
+      framegen_worker_.join();
+    // Completion handlers retain the native session and its source snapshots.
+    // Drain submitted Metal work before releasing the final WMT session ref.
+    device_context_->WaitUntilGPUIdle();
+    framegen_command_queue_ = nullptr;
+    framegen_session_ = nullptr;
+    framegen_lifecycle_.store(FramegenLifecycle::Stopped,
+                              std::memory_order_release);
+  }
+
+  void enterFramegenBypass() {
+    // BYPASS disables only optional generation. The display-link worker keeps
+    // owning the layer and presents real SourceEscrow textures indefinitely.
+    framegen_circuit_open_.store(true, std::memory_order_release);
+    if (framegen_session_)
+      framegen_session_.openGenerationCircuit();
+  }
+
+  void updateFramegenEnablement(bool occluded, bool source_supported) {
+    framegen_requested_ = env::getEnvVar("DXMT_FRAMEGEN_ENABLE") == "1";
+    const bool should_run = framegen_requested_ && !occluded && source_supported;
+    const bool owns_layer = framegen_session_ &&
+        framegen_session_.ownsLayer();
+    const int enablement_mask = (framegen_requested_ ? 1 : 0) |
+        (occluded ? 2 : 0) | (source_supported ? 4 : 0) |
+        (owns_layer ? 8 : 0);
+    if (enablement_mask != framegen_last_enablement_log_mask_) {
+      Logger::info(str::format(
+          "DXMT framegen enablement inputs changed: requested=",
+          framegen_requested_, " occluded=", occluded,
+          " source_supported=", source_supported, " layer_owner=",
+          owns_layer, " source_sequence=", framegen_source_sequence_));
+      framegen_last_enablement_log_mask_ = enablement_mask;
+    }
+    if (framegen_session_ && !framegen_session_.ownsLayer() &&
+        framegen_lifecycle_.load(std::memory_order_acquire) ==
+            FramegenLifecycle::Active) {
+      framegen_lifecycle_.store(FramegenLifecycle::Normal,
+                                std::memory_order_release);
+    }
+
+    if (owns_layer && !should_run) {
+      // Present1 drains an active owner before taking renderer locks. Reaching
+      // this branch means a caller bypassed that gate; keep ownership and
+      // suppress ordinary nextDrawable until the explicit transition runs.
+      framegen_circuit_open_.store(true, std::memory_order_release);
+      return;
+    }
+
+    if (!should_run) {
+      if (!framegen_session_)
+        framegen_lifecycle_.store(FramegenLifecycle::Stopped,
+                                  std::memory_order_release);
+      return;
+    }
+
+    if (!framegen_session_ && !createFramegenSession())
+      return;
+    if (!framegen_command_queue_) {
+      framegen_lifecycle_.store(FramegenLifecycle::Failed,
+                                std::memory_order_release);
+      return;
+    }
+
+    if (framegen_session_.ownsLayer()) {
+      // Keep a valid display owner available whenever the layer claim is
+      // active. A worker that exited is restartable; until it restarts or a
+      // full quiesce transfers the claim, ordinary nextDrawable stays barred.
+      if (!ensureFramegenWorker()) {
+        framegen_lifecycle_.store(FramegenLifecycle::Failed,
+                                  std::memory_order_release);
+        framegen_circuit_open_.store(true, std::memory_order_release);
+        return;
+      }
+      framegen_lifecycle_.store(FramegenLifecycle::Active,
+                                std::memory_order_release);
+      framegen_circuit_open_.store(!framegen_session_.canCapture(),
+                                   std::memory_order_release);
+      return;
+    }
+
+    if (framegen_source_sequence_ != 0) {
+      // The previous source was copied and submitted through ordinary DXMT.
+      // Drain all ordinary command buffers before attaching the display link.
+      device_context_->WaitUntilGPUIdle();
+      if (!ensureFramegenWorker()) {
+        framegen_lifecycle_.store(FramegenLifecycle::Failed,
+                                  std::memory_order_release);
+        return;
+      }
+      framegen_lifecycle_.store(FramegenLifecycle::Starting,
+                                std::memory_order_release);
+      const bool enabled = framegen_session_.setEnabled(true);
+      Logger::info(str::format(
+          "DXMT framegen session reactivation: enabled=", enabled,
+          " layer_owner=", framegen_session_.ownsLayer(),
+          " source_sequence=", framegen_source_sequence_));
+      if (enabled) {
+        framegen_lifecycle_.store(FramegenLifecycle::Active,
+                                  std::memory_order_release);
+      } else {
+        framegen_lifecycle_.store(FramegenLifecycle::Normal,
+                                  std::memory_order_release);
+      }
+    }
+    framegen_circuit_open_.store(!framegen_session_.canCapture(),
+                                 std::memory_order_release);
+  }
+
+  bool quiesceFramegenToNormal() {
+    std::unique_lock transition_lock(framegen_transition_mutex_);
+    framegen_transition_cv_.wait(transition_lock, [&] {
+      return !framegen_transition_active_;
+    });
+    framegen_transition_active_ = true;
+    if (!framegen_session_ || !framegen_session_.ownsLayer()) {
+      if (framegen_lifecycle_.load(std::memory_order_acquire) ==
+          FramegenLifecycle::Draining)
+        framegen_lifecycle_.store(FramegenLifecycle::Normal,
+                                  std::memory_order_release);
+      framegen_transition_active_ = false;
+      transition_lock.unlock();
+      framegen_transition_cv_.notify_all();
+      return true;
+    }
+
+    framegen_lifecycle_.store(FramegenLifecycle::Draining,
+                              std::memory_order_release);
+    const bool started = framegen_session_.beginDrain();
+    const bool quiesced = started && framegen_session_.quiesceToNormal();
+    if (quiesced && !framegen_session_.ownsLayer()) {
+      framegen_worker_stop_requested_.store(true,
+                                             std::memory_order_release);
+      if (framegen_worker_.joinable())
+        framegen_worker_.join();
+      framegen_lifecycle_.store(FramegenLifecycle::Normal,
+                                std::memory_order_release);
+      framegen_circuit_open_.store(false, std::memory_order_release);
+    } else if (framegen_session_.ownsLayer()) {
+      // The layer claim remains authoritative. A later source-only attempt can
+      // retry quiescence; no normal Presenter may call nextDrawable meanwhile.
+      framegen_lifecycle_.store(FramegenLifecycle::Active,
+                                std::memory_order_release);
+      framegen_circuit_open_.store(true, std::memory_order_release);
+    } else {
+      framegen_lifecycle_.store(FramegenLifecycle::Failed,
+                                std::memory_order_release);
+    }
+    framegen_transition_active_ = false;
+    transition_lock.unlock();
+    framegen_transition_cv_.notify_all();
+    return quiesced && !framegen_session_.ownsLayer();
+  }
+
+  bool suspendFramegenForTransition() {
+    if (!quiesceFramegenToNormal())
+      return false;
+    device_context_->WaitUntilGPUIdle();
+    return true;
+  }
+
+  bool framegenSourceSupported(WMT::Texture source, UINT sync_interval,
+                               UINT present_flags,
+                               const DXGI_PRESENT_PARAMETERS *parameters) {
+    if constexpr (EnableMetalFX)
+      return false;
+    if (sync_interval != 1 || present_flags != 0 || parameters != nullptr ||
+        !fullscreen_desc_.Windowed || desc_.SampleDesc.Count != 1 ||
+        colorspace_ != DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709)
+      return false;
+    const auto format = source.pixelFormat();
+    return format == WMTPixelFormatBGRA8Unorm ||
+           format == WMTPixelFormatRGBA8Unorm;
+  }
+
+  void reportFramegenStages(
+      WMTDXMTFramegenTick &tick,
+      const WMTDXMTFramegenSelection &selection) {
+    if (!framegen_session_)
+      return;
+    const auto lifecycle =
+        framegen_lifecycle_.load(std::memory_order_acquire);
+    const bool circuit_open = lifecycle == FramegenLifecycle::Active &&
+        !framegen_session_.canCapture();
+    framegen_circuit_open_.store(circuit_open, std::memory_order_release);
+    tick.lifecycle_state = static_cast<uint64_t>(lifecycle);
+    tick.circuit_state = circuit_open ? 1 : 0;
+    framegen_session_.reportPresentationStages(tick, selection);
+  }
+
+  void framegenPresentationLoop() {
+    struct RetireTick {
+      WMT::Reference<WMT::DXMTFramegenSession> session;
+      uint64_t tick_id;
+      ~RetireTick() {
+        if (session)
+          session.retireTick(tick_id);
+      }
+    };
+    try {
+      env::setThreadName("dxmt-framegen-present");
+      while (!framegen_stopping_.load(std::memory_order_acquire)) {
+        if (framegen_worker_stop_requested_.load(std::memory_order_acquire))
+          break;
