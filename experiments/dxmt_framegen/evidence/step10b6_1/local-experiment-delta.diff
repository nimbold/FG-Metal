+/* LOCAL DOWNSTREAM EXPERIMENT ONLY. Public, read-only diagnostics on the actual
+ * WineMetal layer. Snapshots run on AppKit's main thread outside measurement
+ * callback work. No property is mutated. */
+static void
+framegen_log_layer_snapshot(CAMetalLayer *layer, const char *phase) {
+  const char *path = getenv("DXMT_FRAMEGEN_LAYER_LOG");
+  if (!path || !*path) return;
+  NSView *view = [layer.delegate isKindOfClass:NSView.class] ? (NSView *)layer.delegate : nil;
+  NSWindow *window = view.window;
+  NSScreen *screen = window.screen;
+  CFStringRef color_name = layer.colorspace ? CGColorSpaceCopyName(layer.colorspace) : NULL;
+  CFStringRef color_description = layer.colorspace ? CFCopyDescription(layer.colorspace) : NULL;
+  NSMutableDictionary *values = [NSMutableDictionary dictionaryWithDictionary:@{
+    @"phase": [NSString stringWithUTF8String:phase],
+    @"ca_time": @(CACurrentMediaTime()),
+    @"layer_identity": [NSString stringWithFormat:@"%p", layer],
+    @"device_identity": [NSString stringWithFormat:@"%p", layer.device],
+    @"device_name": layer.device.name ?: @"nil",
+    @"device_registry_id": @(layer.device.registryID),
+    @"pixel_format": @(layer.pixelFormat),
+    @"drawable_width": @(layer.drawableSize.width),
+    @"drawable_height": @(layer.drawableSize.height),
+    @"contents_scale": @(layer.contentsScale),
+    @"layer_frame": NSStringFromRect(layer.frame),
+    @"layer_bounds": NSStringFromRect(layer.bounds),
+    @"opaque": @(layer.opaque),
+    @"framebuffer_only": @(layer.framebufferOnly),
+    @"display_sync_enabled": @(layer.displaySyncEnabled),
+    @"maximum_drawable_count": @(layer.maximumDrawableCount),
+    @"allows_next_drawable_timeout": @(layer.allowsNextDrawableTimeout),
+    @"presents_with_transaction": @(layer.presentsWithTransaction),
+    @"colorspace_name": color_name ? (NSString *)color_name : @"nil",
+    @"colorspace_description": color_description ? (NSString *)color_description : @"nil",
+    @"wants_edr": @(layer.wantsExtendedDynamicRangeContent),
+    @"view_class": view ? NSStringFromClass(view.class) : @"nil",
+    @"view_frame": NSStringFromRect(view.frame),
+    @"view_bounds": NSStringFromRect(view.bounds),
+    @"view_opaque": @(view.opaque),
+    @"superview_class": view.superview ? NSStringFromClass(view.superview.class) : @"nil",
+    @"parent_layer_opaque": @(view.superview.layer.opaque),
+    @"window_identity": [NSString stringWithFormat:@"%p", window],
+    @"window_class": window ? NSStringFromClass(window.class) : @"nil",
+    @"window_style_mask": @(window.styleMask),
+    @"window_frame": NSStringFromRect(window.frame),
+    @"content_rect": NSStringFromRect([window contentRectForFrameRect:window.frame]),
+    @"content_view_bounds": NSStringFromRect(window.contentView.bounds),
+    @"window_backing_scale": @(window.backingScaleFactor),
+    @"window_backing_type": @(window.backingType),
+    @"window_opaque": @(window.opaque),
+    @"window_background": window.backgroundColor.description ?: @"nil",
+    @"window_visible": @(window.visible),
+    @"window_miniaturized": @(window.miniaturized),
+    @"window_key": @(window.keyWindow),
+    @"window_occlusion_state": @(window.occlusionState),
+    @"screen_name": screen.localizedName ?: @"nil",
+    @"screen_frame": NSStringFromRect(screen.frame),
+    @"display_id": [screen.deviceDescription objectForKey:@"NSScreenNumber"] ?: @0,
+    @"screen_max_edr": @(screen.maximumExtendedDynamicRangeColorComponentValue),
+    @"screen_potential_edr": @(screen.maximumPotentialExtendedDynamicRangeColorComponentValue)
+  }];
+  NSError *error = nil;
+  NSData *data = [NSJSONSerialization dataWithJSONObject:values options:NSJSONWritingSortedKeys error:&error];
+  FILE *log = fopen(path, "a");
+  if (log && data) { fwrite(data.bytes, 1, data.length, log); fputc('\n', log); }
+  if (log) fclose(log);
+  if (color_name) CFRelease(color_name);
+  if (color_description) CFRelease(color_description);
+}
+
+static void
+framegen_schedule_layer_snapshots(CAMetalLayer *layer) {
+  const char *path = getenv("DXMT_FRAMEGEN_LAYER_LOG");
+  if (!path || !*path) return;
+  static NSMutableSet *scheduled_layers;
+  if (!scheduled_layers) scheduled_layers = [[NSMutableSet alloc] init];
+  NSValue *key = [NSValue valueWithPointer:layer];
+  if ([scheduled_layers containsObject:key]) return;
+  [scheduled_layers addObject:key];
+  framegen_log_layer_snapshot(layer, "first_set_props");
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 6 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+    framegen_log_layer_snapshot(layer, "settled_6s");
+  });
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 15 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+    framegen_log_layer_snapshot(layer, "measurement_15s");
+  });
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 25 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+    framegen_log_layer_snapshot(layer, "measurement_25s");
+  });
+}
