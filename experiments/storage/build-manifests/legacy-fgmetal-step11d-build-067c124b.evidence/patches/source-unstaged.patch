+    m_activeOrigin = DxvkPresentOrigin::InternalOutput;
+    m_activeImageIndex = m_imageIndex;
+    m_activeAcquireSerial = m_nextAcquireSerial++;
+    m_activeImageGeneration = m_swapchainGeneration.load();
+    m_activeImageLease = true;
+    m_presentPending = true;
+
+    sync = m_semaphores.at(m_frameIndex);
+    image = m_images.at(m_imageIndex);
+    return VK_SUCCESS;
+  }
