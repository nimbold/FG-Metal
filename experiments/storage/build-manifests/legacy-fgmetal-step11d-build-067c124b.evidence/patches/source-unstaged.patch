+  bool Presenter::validateInternalImageLease(
+          InternalPresentId internalPresentId,
+          uint64_t          expectedGeneration) {
+    std::lock_guard lock(m_surfaceMutex);
+
+    bool valid = internalPresentId.value != 0u
+      && m_activeImageLease
+      && m_activeOrigin == DxvkPresentOrigin::InternalOutput
+      && m_activeImageIndex == m_imageIndex
+      && m_activeImageGeneration == expectedGeneration
+      && m_swapchainGeneration.load() == expectedGeneration
+      && !m_dirtySurface
+      && !m_dirtySwapchain
+      && !m_destroyingResources
+      && !m_sourceAcquireIntent.load()
+      && !m_sourceFramePending.load();
