+  VkResult Presenter::tryAcquireInternalImage(
+          uint64_t        expectedGeneration,
+          PresenterSync&  sync,
+          Rc<DxvkImage>&  image,
+    const char**          dropReason) {
+    // The submission owner must never wait behind an application acquire.
+    if (m_shutdownRequested.load() || m_sourceAcquireIntent.load() || m_sourceFramePending.load()) {
+      if (dropReason)
+        *dropReason = m_shutdownRequested.load() ? "presenter-shutdown" : "source-pending";
+      return VK_NOT_READY;
+    }
+
+    std::unique_lock lock(m_surfaceMutex, std::try_to_lock);
+
+    if (!lock.owns_lock()) {
+      if (dropReason)
+        *dropReason = "presenter-busy";
+      return VK_NOT_READY;
+    }
+
+    if (m_shutdownRequested.load() || m_destroyingResources
+     || m_sourceAcquireIntent.load() || m_sourceFramePending.load()) {
+      if (dropReason)
+        *dropReason = m_shutdownRequested.load() ? "presenter-shutdown"
+          : m_destroyingResources ? "presenter-destroying" : "source-pending";
+      return VK_NOT_READY;
+    }
+
+    if (m_presentPending || m_activeImageLease) {
+      if (dropReason)
+        *dropReason = "present-pending";
+      return VK_NOT_READY;
+    }
+
+    // The cached image belongs to the current swapchain epoch. Do not claim
+    // it for optional output after a settings/window change has made that
+    // swapchain or surface pending recreation. The source acquire path owns
+    // recreation and will establish a fresh cached image in the new epoch.
+    if (m_dirtySurface || m_dirtySwapchain) {
+      if (dropReason)
+        *dropReason = "surface-or-swapchain-dirty";
+      return VK_NOT_READY;
+    }
+
+    if (!m_swapchain) {
+      if (dropReason)
+        *dropReason = "no-swapchain";
+      return VK_NOT_READY;
+    }
+
+    if (m_swapchainGeneration.load() != expectedGeneration) {
+      if (dropReason)
+        *dropReason = "generation-changed";
+      return VK_NOT_READY;
+    }
+
+    if (m_acquireStatus != VK_SUCCESS) {
+      if (dropReason)
+        *dropReason = "image-unavailable";
+      return VK_NOT_READY;
+    }
