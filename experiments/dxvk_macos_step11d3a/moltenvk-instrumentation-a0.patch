+				}
+				if (slot.queue && len > 0 && (size_t)len < sizeof(lineBuf)) {
+					len += snprintf(lineBuf + len, sizeof(lineBuf) - len, ",\"queue\":\"0x%" PRIxPTR "\"", (uintptr_t)slot.queue);
+				}
+				if (slot.hasPresentId && len > 0 && (size_t)len < sizeof(lineBuf)) {
+					len += snprintf(lineBuf + len, sizeof(lineBuf) - len, ",\"present_id\":%" PRIu64, slot.presentId);
+				}
+				if (slot.hasPresentIDGoogle && len > 0 && (size_t)len < sizeof(lineBuf)) {
+					len += snprintf(lineBuf + len, sizeof(lineBuf) - len, ",\"present_id_google\":%u", slot.presentIDGoogle);
+				}
+				if (slot.hasFrameIndex && len > 0 && (size_t)len < sizeof(lineBuf)) {
+					len += snprintf(lineBuf + len, sizeof(lineBuf) - len, ",\"frame_index\":%" PRIu64, slot.frameIndex);
+				}
+				if (slot.hasDurationNs && len > 0 && (size_t)len < sizeof(lineBuf)) {
+					len += snprintf(lineBuf + len, sizeof(lineBuf) - len, ",\"duration_ns\":%" PRIu64, slot.durationNs);
+				}
+				if (slot.hasCallBeginNs && len > 0 && (size_t)len < sizeof(lineBuf)) {
+					len += snprintf(lineBuf + len, sizeof(lineBuf) - len, ",\"call_begin_ns\":%" PRIu64, slot.callBeginNs);
+				}
+				if (slot.hasCallEndNs && len > 0 && (size_t)len < sizeof(lineBuf)) {
+					len += snprintf(lineBuf + len, sizeof(lineBuf) - len, ",\"call_end_ns\":%" PRIu64, slot.callEndNs);
+				}
+				if (slot.hasActualPresentTimeNs && len > 0 && (size_t)len < sizeof(lineBuf)) {
+					len += snprintf(lineBuf + len, sizeof(lineBuf) - len, ",\"actual_present_time_ns\":%" PRIu64, slot.actualPresentTimeNs);
