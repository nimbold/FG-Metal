+	static void mvkShutdownNativeTrace() {
+		if (gMVKTraceDrainRunning.exchange(false)) {
+			pthread_join(gMVKTraceDrainThread, nullptr);
+			if (gMVKTraceFd >= 0) {
+				close(gMVKTraceFd);
+				gMVKTraceFd = -1;
+			}
+		}
+	}
+
+	static void mvkInitializeNativeTrace() {
+		const char* tracePath = getenv("FG_NATIVE_MVK_TRACE");
+		if (tracePath && tracePath[0]) {
+			gMVKTraceFd = open(tracePath, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+			if (gMVKTraceFd >= 0) {
+				gMVKTraceBuffer = (MVKNativeTraceSlot*)calloc(kMVKTraceCapacity, sizeof(MVKNativeTraceSlot));
+				if (gMVKTraceBuffer) {
+					gMVKTraceDrainRunning.store(true);
+					pthread_attr_t attr;
+					pthread_attr_init(&attr);
+					pthread_attr_set_qos_class_np(&attr, QOS_CLASS_BACKGROUND, 0);
+					if (pthread_create(&gMVKTraceDrainThread, &attr, mvkTraceDrainWorker, nullptr) == 0) {
+						atexit(mvkShutdownNativeTrace);
+					} else {
+						gMVKTraceDrainRunning.store(false);
+					}
+					pthread_attr_destroy(&attr);
+				}
+			}
+		}
+	}
+}
+
+bool mvkNativeTraceEnabled() {
+	call_once(gNativeTraceInitOnce, mvkInitializeNativeTrace);
+	return gMVKTraceFd >= 0 && gMVKTraceBuffer != nullptr;
+}
+
+uint64_t mvkNativeTraceNow() {
+	call_once(gNativeTraceTimebaseOnce, [] { mach_timebase_info(&gNativeTraceTimebase); });
+	uint64_t ticks = mach_absolute_time();
+	if (!gNativeTraceTimebase.denom) { return ticks; }
+	return (uint64_t)(((__uint128_t)ticks * gNativeTraceTimebase.numer) / gNativeTraceTimebase.denom);
+}
+
+void mvkNativeTraceLog(const char* event, const MVKNativeTraceRecord& record) {
+	if (!mvkNativeTraceEnabled() || !gMVKTraceBuffer) { return; }
+
+	uint64_t timestampNs = mvkNativeTraceNow();
+	uint64_t threadID = 0;
+	pthread_threadid_np(pthread_self(), &threadID);
+	uint64_t eventID = gMVKTraceEventID.fetch_add(1, memory_order_relaxed) + 1;
+	uint64_t ticket = gMVKTraceHead.fetch_add(1, memory_order_relaxed);
+
+	uint64_t currentTail = gMVKTraceTail.load(memory_order_acquire);
+	if (ticket >= currentTail + kMVKTraceCapacity) {
+		gMVKTraceDroppedCount.fetch_add(1, memory_order_relaxed);
+		return;
+	}
+
+	MVKNativeTraceSlot& slot = gMVKTraceBuffer[ticket & kMVKTraceMask];
+	slot.ready.store(0, memory_order_relaxed);
+	slot.event_id = eventID;
+	slot.timestamp_ns = timestampNs;
+	slot.tid = threadID;
+	slot.event = event;
+	slot.swapchain = record.swapchain;
+	slot.image = record.image;
+	slot.imageIndex = record.imageIndex;
+	slot.hasImageIndex = record.hasImageIndex;
+	slot.acquisitionSequence = record.acquisitionSequence;
+	slot.hasAcquisitionSequence = record.hasAcquisitionSequence;
+	slot.drawable = record.drawable;
+	slot.texture = record.texture;
+	slot.queue = record.queue;
+	slot.presentId = record.presentId;
+	slot.hasPresentId = record.hasPresentId;
+	slot.presentIDGoogle = record.presentIDGoogle;
+	slot.hasPresentIDGoogle = record.hasPresentIDGoogle;
+	slot.frameIndex = record.frameIndex;
+	slot.hasFrameIndex = record.hasFrameIndex;
+	slot.durationNs = record.durationNs;
+	slot.hasDurationNs = record.hasDurationNs;
+	slot.callBeginNs = record.callBeginNs;
+	slot.hasCallBeginNs = record.hasCallBeginNs;
+	slot.callEndNs = record.callEndNs;
+	slot.hasCallEndNs = record.hasCallEndNs;
+	slot.actualPresentTimeNs = record.actualPresentTimeNs;
+	slot.hasActualPresentTimeNs = record.hasActualPresentTimeNs;
+	slot.attemptIndex = record.attemptIndex;
+	slot.hasAttemptIndex = record.hasAttemptIndex;
+	slot.result = (int32_t)record.result;
+	slot.hasResult = record.hasResult;
+	slot.detail = record.detail;
+	slot.isDisplayed = record.isDisplayed;
+	slot.hasIsDisplayed = record.hasIsDisplayed;
+	slot.ready.store(1, memory_order_release);
+}
